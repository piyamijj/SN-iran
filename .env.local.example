# SN-iran — ortam değişkenleri ŞABLONU (gerçek anahtar içermez). .env.local olarak kopyalayın.

# Site alan adı (protokolsüz)
NEXT_PUBLIC_DOMAIN=sn-iran.vercel.app

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis (REST) — dedup, piyasa önbelleği, rate limit
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# AI
GROQ_API_KEYS=key1,key2   # virgülle ayrılmış; tek anahtar için GROQ_API_KEY de olur
GEMINI_API_KEYS=key1,key2 # virgülle ayrılmış; tek anahtar için GEMINI_API_KEY de olur
# GEMINI_API_KEY_2=            # opsiyonel yedek anahtar (kota aşımında otomatik geçiş)
# GROQ_FAST_MODEL=openai/gpt-oss-20b    # çeviri/özet modeli (opsiyonel)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b   # chatbot modeli (opsiyonel)

# Cron / güvenlik
CRON_SECRET=uzun-rastgele-bir-deger

# Opsiyonel: İran sitelerine (Tasnim, Fars...) yurtdışından erişim için proxy.
# Çağrı biçimi: ${RSS_PROXY_URL}${encodeURIComponent(hedefUrl)}  (README'ye bakın)
# RSS_PROXY_URL=https://your-worker.workers.dev/?url=
# RSS_PROXY_TOKEN=
# INGEST_MAX_PER_RUN=24
